{
  "name": "sapphire-desktop",
  "productName": "Sapphire",
  "version": "0.1.0",
  "description": "Sapphire for Windows: the teleprompter app plus the Hub (cameras and mics on this computer).",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.sapphireproductions.app",
    "productName": "Sapphire",
    "files": ["main.js", "preload.js", "icon.png"],
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": { "oneClick": true, "perMachine": false, "shortcutName": "Sapphire" },
    "directories": { "output": "dist" }
  }
}
